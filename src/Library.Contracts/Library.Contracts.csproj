<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The contract lives once, at the repo root, and generates both sides here. Neither the API
         nor the service owns it, and neither can drift from the other. -->
    <Protobuf Include="..\..\proto\library.proto" GrpcServices="Both" Link="library.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
